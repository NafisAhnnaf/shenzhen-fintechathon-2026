# Base Sepolia. Five separate keys: the agent key must differ from all others (B6).
# Fund each with a little Base Sepolia ETH from a faucet. Never put mainnet keys here.
BASE_SEPOLIA_RPC=https://sepolia.base.org
OWNER_KEY=
AGENT_KEY=
GOVERNOR_KEY=
APPROVER_KEY=
UNDERWRITER_KEY=
