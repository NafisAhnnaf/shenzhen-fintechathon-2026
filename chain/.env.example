# Base Sepolia. Six separate keys: the agent key must differ from all others (B6), and the arbiter must not be
# the owner or the bank. node scripts/testnet-keys.js creates them.
# Fund each with a little Base Sepolia ETH from a faucet. Never put mainnet keys here.
BASE_SEPOLIA_RPC=https://sepolia.base.org
OWNER_KEY=
AGENT_KEY=
GOVERNOR_KEY=
APPROVER_KEY=
UNDERWRITER_KEY=
# Settles disputed reserve claims. Or set ARBITER_ADDRESS to an outside address and leave ARBITER_KEY empty.
ARBITER_KEY=
ARBITER_ADDRESS=
