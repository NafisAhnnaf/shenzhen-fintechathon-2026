# =============================================================================
# Bonded Payables Agent - Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Google Gemini API Configuration
# -----------------------------------------------------------------------------
# Set your Gemini API key here (get one at https://aistudio.google.com/app/apikey).
# The agent will automatically detect GEMINI_API_KEY (or gemini_api_key) and use it
# as the fallback for VLM and LLM services if dedicated keys are not provided.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Vision-Language Model (VLM) - PDF & Photo Bill Reader
# -----------------------------------------------------------------------------
# The VLM processes scanned/photographed bills and PDFs into structured fields.
# Uses Google Gemini via its OpenAI-compatible endpoint:
# https://generativelanguage.googleapis.com/v1beta/openai/
#
# Supported models:
# - gemini-3.8-flash (recommended)
# - gemini-1.5-flash
# - gemini-1.5-pro
VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VLM_MODEL=gemini-3.8-flash
VLM_API_KEY=${GEMINI_API_KEY}

# -----------------------------------------------------------------------------
# Intent Decider (LLM) - Natural Language Request Router
# -----------------------------------------------------------------------------
# DECIDER determines how plain-language requests from the owner/desk are parsed:
# - rules: Uses offline rule-based heuristic decider (recommended, starts instantly)
# - llm: Uses Gemini to classify user intent and slots into structured plans
DECIDER=rules
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=${GEMINI_API_KEY}

# -----------------------------------------------------------------------------
# Core Server & Agent Settings
# -----------------------------------------------------------------------------
# Target blockchain network: localhost | fisco | baseSepolia
NETWORK=localhost

# ERP adapter: file (demo baseline ledger) | csv (CSV/Excel exports) | odoo (live Odoo 17)
ERP=file

# Signing mode:
# - client: Owner and Finance Manager sign in their own browser wallets (default)
# - server: Server holds all keys (for automated testing / scripted tasks)
SIGNING=client

# RPC URL for browser wallets to connect through
RPC_PUBLIC=http://127.0.0.1:8545

# -----------------------------------------------------------------------------
# Blockchain Role Keys (Only needed for Base Sepolia testnet or live chains)
# On local hardhat and fisco networks, default test mnemonic keys are used automatically.
# -----------------------------------------------------------------------------
BASE_SEPOLIA_RPC=https://sepolia.base.org
FISCO_RPC=http://127.0.0.1:8546

OWNER_KEY=
AGENT_KEY=
GOVERNOR_KEY=
APPROVER_KEY=
UNDERWRITER_KEY=
ARBITER_ADDRESS=

# -----------------------------------------------------------------------------
# ERP Settings (Used when ERP=odoo or ERP=csv)
# -----------------------------------------------------------------------------
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=payables
ODOO_USER=admin
ODOO_PASSWORD=admin
ODOO_MASTER_PASSWORD=admin
ODOO_HISTORY_FROM=2025-10-01

# CSV ERP export directory and column mapping (when ERP=csv)
# ERP_CSV_DIR=data/erp/odoo_export
# ERP_CSV_MAPPING=data/erp/odoo_export/mapping.json

# -----------------------------------------------------------------------------
# Web Desk & Wallet Configuration
# -----------------------------------------------------------------------------
# Reown / WalletConnect Project ID for mobile phone approval (free from cloud.reown.com)
VITE_WC_PROJECT_ID=
