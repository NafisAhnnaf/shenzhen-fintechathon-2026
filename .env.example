# =============================================================================
# Bonded Payables Agent - Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Google Gemini API Configuration
# -----------------------------------------------------------------------------
# Set your Gemini API key here (get one at https://aistudio.google.com/app/apikey).
# The agent will automatically detect GEMINI_API_KEY (or gemini_api_key) and use it
# as the fallback for VLM and LLM services if dedicated keys are not provided.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Vision-Language Model (VLM) - PDF & Photo Bill Reader
# -----------------------------------------------------------------------------
# The VLM processes scanned/photographed bills and PDFs into structured fields.
# Uses Google Gemini via its OpenAI-compatible endpoint:
# https://generativelanguage.googleapis.com/v1beta/openai/
#
# Supported models:
# - gemini-3.6-flash
VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VLM_MODEL=gemini-3.6-flash
VLM_API_KEY=${GEMINI_API_KEY}

# -----------------------------------------------------------------------------
# Intent Decider (LLM) - Natural Language Request Router
# -----------------------------------------------------------------------------
# DECIDER: how typed requests are read.
# - llm (default when a model key is set): the model picks the intent and values from a fixed list; if it fails,
#   the rule decider answers instead. Calibrate once: python -m apagent.intent.calibrate_llm (about 100 calls).
# - rules: the offline rule decider only.
DECIDER=llm
LLM_MODEL=gemini-3.5-flash-lite
# The invoice reader uses VLM_MODEL (default gemini-3.6-flash) and switches to this when its daily allowance is used up
VLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# Core Server & Agent Settings
# -----------------------------------------------------------------------------
# Target blockchain network: localhost | fisco | baseSepolia
NETWORK=localhost

# ERP adapter: file (demo baseline ledger) | csv (CSV/Excel exports) | odoo (live Odoo 17)
ERP=file

# Signing mode:
# - client: Owner and Finance Manager sign in their own browser wallets (default)
# - server: Server holds all keys (for automated testing / scripted tasks)
SIGNING=client

# RPC URL for browser wallets to connect through
RPC_PUBLIC=http://127.0.0.1:8545

# -----------------------------------------------------------------------------
# Blockchain Role Keys (Only needed for Base Sepolia testnet or live chains)
# On local hardhat and fisco networks, default test mnemonic keys are used automatically.
# -----------------------------------------------------------------------------
BASE_SEPOLIA_RPC=https://sepolia.base.org
FISCO_RPC=http://127.0.0.1:8546

OWNER_KEY=
AGENT_KEY=
GOVERNOR_KEY=
APPROVER_KEY=
UNDERWRITER_KEY=
ARBITER_ADDRESS=

# -----------------------------------------------------------------------------
# ERP Settings (Used when ERP=odoo or ERP=csv)
# -----------------------------------------------------------------------------
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=payables
ODOO_USER=admin
ODOO_PASSWORD=admin
ODOO_MASTER_PASSWORD=admin
ODOO_HISTORY_FROM=2025-10-01

# CSV ERP export directory and column mapping (when ERP=csv)
# ERP_CSV_DIR=data/erp/odoo_export
# ERP_CSV_MAPPING=data/erp/odoo_export/mapping.json

# -----------------------------------------------------------------------------
# Web Desk & Wallet Configuration
# -----------------------------------------------------------------------------
# Reown / WalletConnect Project ID for mobile phone approval (free from cloud.reown.com)
VITE_WC_PROJECT_ID=

# ------------------------------------------------------------------------------
# Email the agent sends and reads (docs/spec.md V2, R4, policy S11)
# ------------------------------------------------------------------------------
# AgentMail (preferred): the agent's own inbox through its API. Takes priority over SMTP/IMAP below.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
# Mail to suppliers goes to their real address only with MAIL_LIVE=on. Otherwise it goes to this sandbox inbox
# (with the intended recipient at the top), or to the outbox folder if empty: the sample suppliers' addresses may
# belong to real companies. Invitations and password resets always go to the real person.
MAIL_SANDBOX_TO=
MAIL_LIVE=off

# Without SMTP_HOST, outgoing mail is written to data/state/outbox/ as .eml files.
AUTO_EMAIL=on
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Without IMAP_HOST, .eml files dropped into data/state/mailbox/ are read.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Read the mailbox every N seconds (0 = only when someone presses "Check mail").
MAILBOX_POLL_SECONDS=0

# ------------------------------------------------------------------------------
# Security (docs/spec.md X2, X5)
# ------------------------------------------------------------------------------
# Wallet sign-in for the API. Set AUTH=off only for scripted runs.
AUTH=on
# The governor service (apagent/governor_service.py). When set, the API never loads the governor key.
GOVERNOR_URL=http://127.0.0.1:8001
GOVERNOR_TOKEN=

# ------------------------------------------------------------------------------
# Notifications (docs/spec.md E8): a chat message when someone must act
# ------------------------------------------------------------------------------
NOTIFY_WEBHOOK_URL=
# wecom (WeCom group robot), slack or teams
NOTIFY_FORMAT=wecom

# ------------------------------------------------------------------------------
# Mainland fapiao check (docs/spec.md C6)
# ------------------------------------------------------------------------------
# A verification provider's endpoint; without it the demo's simulated registry is used.
FAPIAO_API_URL=
# on: hold mainland bills that quote no fapiao number
FAPIAO_REQUIRED=off

# ------------------------------------------------------------------------------
# Database (docs/spec.md: Neon Postgres in production)
# ------------------------------------------------------------------------------
# postgres: keep state in DATABASE_URL (one set of rows per company); file: a local file (scripted runs, tests)
STATE_STORE=file
DATABASE_URL=
# Signs the agent's saved working memory. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=

# ------------------------------------------------------------------------------
# Sign-in (auth/, Better Auth on the same database)
# ------------------------------------------------------------------------------
# accounts: company staff sign in with email and password (the login service must run: cd auth && npm start);
# wallet: everyone signs in with a wallet and the deployment record decides the role (local runs without a database).
# Empty: accounts when STATE_STORE=postgres and BETTER_AUTH_SECRET is set.
LOGIN=
# Shared by the login service and the API (the API checks the session cookie's signature with it). Generate as above.
BETTER_AUTH_SECRET=
# The address people open in the browser (the API serves the app and forwards /api/auth/* to the login service)
PUBLIC_URL=http://127.0.0.1:8000
AUTH_SERVICE_URL=http://127.0.0.1:3001
AUTH_PORT=3001
